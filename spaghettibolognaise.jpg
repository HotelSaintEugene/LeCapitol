/*# sourceMappingURL=0ame7h0inud2k.css.map*/@media (min-width:768px){.styles-module__LJzoYG__layout .related-products-block{border-top-left-radius:2rem;border-top-right-radius:2rem}}.styles-module__LJzoYG__hero{padding:0 1.5rem}@media (min-width:768px){.styles-module__LJzoYG__hero{padding:0}}.styles-module__LJzoYG__header{text-align:center;flex-flow:column;gap:1rem;padding:4rem 2rem 2rem;display:flex}@media (min-width:768px){.styles-module__LJzoYG__header{padding:4rem 4rem 2rem}}.styles-module__LJzoYG__title{font-family:var(--font-family-poppins);font-size:3.6rem;line-height:1.2;font-weight:var(--font-weight-extra-bold);color:var(--color-arapawa)}.styles-module__LJzoYG__subtitle{font-family:var(--font-family-poppins);font-size:2rem;line-height:1.2;font-weight:var(--font-weight-bold);color:var(--color-bismark)}.styles-module__LJzoYG__content{padding:0 1.5rem}@media (min-width:768px){.styles-module__LJzoYG__content{padding:0}}.styles-module__LJzoYG__description{margin:4rem 0 6rem}@media (min-width:768px){.styles-module__LJzoYG__description{margin:6rem 0 8rem;padding-inline:3rem}}.styles-module__LJzoYG__topCardsBlock{margin-bottom:8rem}.styles-module__LJzoYG__html{border-top:1px solid var(--color-gainsboro);padding:4rem 1.5rem}.styles-module__LJzoYG__html h4{font-family:var(--font-family-poppins);font-size:2rem;line-height:1.2;font-weight:var(--font-weight-bold);color:var(--color-arapawa);margin:0 0 2rem}.styles-module__LJzoYG__html p{font-family:var(--font-family-work-sans);font-size:1.6rem;line-height:1.5;font-weight:var(--font-weight-medium);color:var(--color-bismark)}@media (min-width:768px){.styles-module__LJzoYG__html{padding:4rem 3rem}}.styles-module__LJzoYG__cardsBlock{margin-bottom:8rem}@media (min-width:768px){.styles-module__LJzoYG__cardsBlock{padding-inline:3rem}}.styles-module__LJzoYG__tagsCloud{border-top:1px solid var(--color-gainsboro);padding-top:2rem;padding-bottom:4rem}.styles-module__LJzoYG__tagsCloud h2{text-align:start;width:100%}.styles-module__LJzoYG__tagsCloud nav{justify-content:flex-start}@media (min-width:768px){.styles-module__LJzoYG__tagsCloud{padding-bottom:5rem;padding-inline:3rem}.styles-module__LJzoYG__tagsCloud h2{padding-top:3rem}}.styles-module__LJzoYG__styledPagination.styles-module__LJzoYG__styledPagination{border-top:1px solid var(--color-gainsboro);padding-top:2rem}
