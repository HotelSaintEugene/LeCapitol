y);text-align:center;margin:0;font-family:Poppins,sans-serif;font-size:2.4rem;font-weight:700;line-height:1.2}@media (min-width:768px){.styles-module__iBNkAG__pushTitle{font-size:3rem}}.styles-module__iBNkAG__pushLink{justify-content:center;align-items:center;gap:1.5rem;text-decoration:none;transition:opacity .2s;display:flex}.styles-module__iBNkAG__pushLink:hover{opacity:.8}.styles-module__iBNkAG__pushIcon{color:var(--color-arapawa);flex-shrink:0}.styles-module__iBNkAG__pushUsername{color:var(--color-arapawa);font-family:Poppins,sans-serif;font-size:2rem;font-weight:700;line-height:1.2}@media (min-width:768px){.styles-module__iBNkAG__pushUsername{font-size:2.4rem}}\n/*# sourceMappingURL=3lste3t6i8tep.css.map*/41:[\"$\",\"$L46\",null,{\"stickyEnabled\":true,\"interstitiel\":{\"__typename\":\"ConfigurationInterstitiel\",\"active\":false,\"id\":null,\"surtitle\":null,\"title\":\"Interstitiel\",\"image\":null,\"description\":null,\"cta1\":null,\"cta2\":null,\"slides\":[]},\"children\":[\"$\",\"$L1c\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$47\",\"errorStyles\":[],\"errorScripts\":[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2cjzl64vupygf.js\",\"async\":true}]],\"template\":[\"$\",\"$L1d\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[\"$L48\",[[\"$\",\"style\",\"0\",{\"nonce\":\"$undefined\",\"precedence\":\"next\",\"href\":\"/_next/static/chunks/0tauj-sxo-7ha.css\",\"children\":\"$49\"}]]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]\n4a:T65b,{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Spaghetti bolognaise : recette traditionnelle\",\"description\":\"Vous avez sûrement goûté à la sauce bolognaise, mais avez-vous déjà cuisiné sa version traditionnelle ? Dans cette recette de ragù alla bolognese, les ingrédients sont sélectionnés pour offrir une expérience culinaire authentique. À la base, des légumes finement coupés – oignon, carotte et céleri – revenus doucement dans un mélange de beurre et d’huile d’olive. On y ajoute du bœuf haché, un peu de lait pour adoucir l’acidité de la tomate, et du vin blanc pour équilibrer le tout. Cette sauce classique, simple mais incroyablement riche en goût, se prépare en quelques étapes et fait des merveilles sur des pâtes al dente.Prête en moins de deux heures dans sa version allongée, elle vous transporte directement en Italie, avec un plat qui, de la cuisine à l’assiette, respire l’authenticité. Cette sauce peut être réalisée en 20 minutes pour une version rapide. Cependant, la recette traditionnelle recommande une cuisson longue pour permettre aux saveurs de la viande, des légumes et du vin de se fondre et s'intensifier. Ce temps de mijotage révèle toute la richesse des arômes.Pour plus d’inspiration, découvrez aussi notre sélection des meilleures recettes de sauces pour sublimer vos pâtes.\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"@id\":\"/r-spaghetti-bolognaise-au-fromage-rape-italien#mainImage\",\"url\":\"https://www.quiveutdufromage.com/api/dam/schema-image?wedia_uuid=fix635d9eidk9muu7yq33zuescmdts13b7bw94o\",\"width\":1200,\"height\":1200}}43:[\"$\",\"script\",null,{\"id\":\"json-ld-page\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$4a\"}}]\n44:[\"$\",\"$L4b\",null,{\"brand\":\"GIOVANNI FERRARI\",\"group\":\"recette\",\"page\":\"Spaghetti bolognaise : recette traditionnelle\",\"hideRubrique\":true}]\n4d:T618,\u003cp\u003e\u003cspan\u003eVous avez sûrement goûté à la sauce bolognaise, mais avez-vous déjà cuisiné sa version traditionnelle ? Dans cette recette de \u003c/span\u003e\u003cem\u003e\u003cspan\u003eragù alla bolognese\u003c/span\u003e\u003c/em\u003e\u003cspan\u003e, les ingrédients sont sélectionnés pour offrir une expérience culinaire authentique. À la base, des légumes finement coupés – oignon, carotte et céleri – revenus doucement dans un mélange de beurre et d’huile d’olive. On y ajoute du bœuf haché, un peu de lait pour adoucir l’acidité de la tomate, et du vin blanc pour équilibrer le tout. Cette sauce classique, simple mais incroyablement riche en goût, se prépare en quelques étapes et fait des merveilles sur des pâtes \u003c/span\u003e\u003cem\u003e\u003cspan\u003eal dente\u003c/span\u003e\u003c/em\u003e\u003cspan\u003e.\u003c/span\u003e\u003c/p\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003ePrête en moins de deux heures dans sa version allongée, elle vous transporte directement en Italie, avec un plat qui, de la cuisine à l’assiette, respire l’authenticité. Cette sauce peut être réalisée en 20 minutes pour une version rapide. Cependant, la recette traditionnelle recommande une cuisson longue pour permettre aux saveurs de la viande, des légumes et du vin de se fondre et s'intensifier. Ce temps de mijotage révèle toute la richesse des arômes.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan\u003ePour plus d’inspiration, découvrez aussi notre sélection des meilleures \u003c/span\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/ar-meilleures-recettes-de-sauces-pour-sublimer-vos-pates\" tt-mode=\"url\"\u003e\u003cspan\u003e\u003cu\u003erecettes de sauces pour sublimer vos pâtes\u003c/u\u003e\u003c/span\u003e\u003c/a\u003e\u003cspan\u003e.\u003c/span\u003e\u003c/p\u003e4e:Te23,\u003cp\u003e\u003cspan\u003eDans la recette traditionnelle de spaghetti bolognaise, l’objectif est de mettre en avant le goût naturel des ingrédients, surtout celui de la viande, des légumes et du vin. Les épices et herbes fortes comme l’origan ou le piment de Cayenne pourraient masquer ces saveurs subtiles. Si vous aimez les plats relevés, rien ne vous empêche d’ajouter un peu d’épices ou de basilic pour une touche plus personnelle, mais la version traditionnelle mise surtout sur l’équilibre simple des ingrédients de base.\u003c/span\u003e\u003c/p\u003e\u003ch3\u003e\u003cstrong\u003e\u003cspan\u003eFaut-il mieux mettre du vin rouge ou du vin blanc ?\u003c/span\u003e\u003c/strong\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eSi vous hésitez entre le vin rouge et le vin blanc pour votre bolognaise, sachez que la recette traditionnelle privilégie le vin blanc. Ce choix peut surprendre, mais il s'explique par la volonté de ne pas alourdir la sauce. Le vin blanc apporte une acidité subtile, qui équilibre les saveurs sans masquer la douceur naturelle des légumes et le goût riche de la viande. En revanche, le vin rouge, plus corsé, ajoute des notes intenses qui dominent parfois les arômes délicats du plat. Optez donc pour le vin blanc si vous souhaitez un goût plus harmonieux et fidèle à la tradition italienne.\u003c/span\u003e\u003c/p\u003e\u003ch3\u003e\u003cstrong\u003e\u003cspan\u003eQuel coulis de tomate choisir ?\u003c/span\u003e\u003c/strong\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003ePour une bolognaise traditionnelle, privilégiez un coulis de tomates de qualité, idéalement bio et sans additifs. Si le coulis bio n'est pas disponible, optez pour des tomates en conserve sans additifs. Si vous avez des tomates pelées en boîte, mixez-les pour obtenir un coulis frais et riche en goût.\u003c/span\u003e\u003c/p\u003e\u003ch3\u003e\u003cstrong\u003e\u003cspan\u003eD'autres recettes proches à découvrir...\u003c/span\u003e\u003c/strong\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003ePour les amoureux de spaghetti bolognaise traditionnel, voici quatre autres recettes italiennes qui devraient vous plaire. Et découvrez aussi notre sélection des meilleures \u003c/span\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/ar-guide-de-recettes-au-parmesan-pour-un-repas-a-l-italienne\" tt-mode=\"url\"\u003e\u003cspan\u003e\u003cu\u003erecettes avec du parmesan\u003c/u\u003e\u003c/span\u003e\u003c/a\u003e\u003cspan\u003e.\u0026nbsp;\u003c/span\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp dir=\"ltr\"\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/r-lasagnes-bolognaises-au-fromage-italien-parmigiano-reggiano\" tt-mode=\"url\"\u003e\u003cstrong\u003e\u003cspan\u003e\u003cu\u003eLasagne bolognaise traditionnelle\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cspan\u003e :\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e Un grand classique italien avec des couches de pâtes, sauce bolognaise et Parmigiano Reggiano fondant.\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp dir=\"ltr\"\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/r-pates-carbonara-au-parmesan\" tt-mode=\"url\"\u003e\u003cstrong\u003e\u003cspan\u003e\u003cu\u003eSpaghetti carbonara traditionnelle\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cspan\u003e :\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e Une sauce crémeuse à base de parmesan et de lardons, sans crème ajoutée, pour une carbonara authentique.\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp dir=\"ltr\"\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/r-pates-a-la-feta-et-aux-tomates-roties-feta-pasta\" tt-mode=\"url\"\u003e\u003cstrong\u003e\u003cspan\u003e\u003cu\u003ePâtes à la feta et tomates rôties\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cspan\u003e :\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e Une variante gourmande où le coulis de tomate est remplacé par une sauce onctueuse à la feta rôtie.\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp dir=\"ltr\"\u003e\u003ca target=\"_blank\" href=\"https://www.quiveutdufromage.com/r-spaghetti-aux-lardons-et-fromage-bleu\" tt-mode=\"url\"\u003e\u003cstrong\u003e\u003cspan\u003e\u003cu\u003eSpaghetti aux lardons et fromage bleu\u003c/u\u003e\u003c/span\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cspan\u003e :\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e Un mélange savoureux pour les amateurs de pâtes au goût prononcé.\u003c/span\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e45:[\"$\",\"$L4c\",null,{\"pageData\":{\"data\":{\"__typename\":\"Recipe\",\"introduction\":\"$4d\",\"budget\":null,\"preparationTime\":\"00:20:00\",\"cookingTime\":\"00:20:00\",\"pinterestImage\":null,\"seo\":{\"__typename\":\"Seo\",\"title\":\"Spaghetti bolognaise traditionnelle : pâte, tomate et viande hachée\",\"description\":\"Découvrez la vraie recette de spaghetti bolognaise traditionnelle : sauce tomate, viande, légumes et parmesan pour une saveur intense. À réaliser en version rapide ou mijotée !\",\"picture\":null,\"robots\":\"index, follow\"},\"outroTitle\":\"Pourquoi la recette traditionnelle n’inclut pas d’épices ?\",\"outroBody\":\"$4e\",\"tags\":[{\"__typename\":\"Tag\",\"id\":\"245\",\"name\":\"Pâtes\",\"slug\":\"pates--245\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"578\",\"name\":\"Plat\",\"slug\":\"plat--578\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"285\",\"name\":\"Recette équilibrée\",\"slug\":\"recette-equilibree--285\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"206\",\"name\":\"Recette familiale\",\"slug\":\"recette-familiale--206\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"133\",\"name\":\"Bœuf\",\"slug\":\"boeuf--133\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"1737\",\"name\":\"Automne\",\"slug\":\"automne\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"208\",\"name\":\"Recettes pas chères\",\"slug\":\"recettes-pas-cheres--208\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"634\",\"name\":\"Parmesan\",\"slug\":\"parmesan--634\",\"styleColor\":\"YELLOW\",\"picto\":null},{\"__typename\":\"Tag\",\"id\":\"1734\",\"name\":\"Eté\",\"slug\":\"ete\",\"styleColor\":\"YELLOW\",\"picto\":\"sun\"},{\"__typename\":\"Tag\",\"id\":\"911\",\"name\":\"C